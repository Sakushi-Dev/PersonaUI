# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# === RUNTIME-GENERIERTE DATEIEN ===

# Logs
*.log
src/logs/

# Database
*.db
*.db.backup
*.sqlite
*.sqlite3

# Data-Verzeichnis (Sessions, Messages, Persona-Daten)
src/data/

# Backup-Dateien
*.backup

# Settings-Verzeichnis komplett ignorieren, nur defaults + model_options versioniert
src/settings/*
!src/settings/defaults.json
!src/settings/model_options.json

# Benutzer-erstellte Personas
src/instructions/created_personas/

# Cortex-Dateien (Persona-Erinnerungen, benutzergeneriert)
src/instructions/personas/cortex/default/*.md
src/instructions/personas/cortex/custom/

# Aktive Persona-Config (wird bei jeder Aktivierung überschrieben)
src/instructions/personas/active/persona_config.json

# User-Manifest (benutzerdefinierte Prompts, darf nicht überschrieben werden)
src/instructions/prompts/_meta/user_manifest.json
src/instructions/prompts/_meta/user_placeholder_registry.json
src/instructions/prompts/_meta/_backups/

# Custom Persona-Specs
src/instructions/personas/spec/custom_spec/custom_spec.json

# Benutzer-Uploads (Custom-Avatare)
frontend/public/avatar/costum/

# Avatar-Index (wird zur Laufzeit generiert)
frontend/public/avatar/index.json

# Temporäre Dateien
*.tmp
*.temp
*.backup
src/restart_server.bat

# pytest_cache
.pytest_cache/

# ruff_cache
.ruff_cache/

# Lokale Node.js-Installation (automatisch heruntergeladen)
bin/node/
bin/node-*/

# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json*

src/instructions/prompts/*.json*